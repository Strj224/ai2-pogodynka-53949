{% extends 'base.html.twig' %}

{% block title %}Measurements{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Measurements</h1>

        <a href="{{ path('app_measurement_new') }}" class="btn btn-success mb-3">Create New Measurement</a>
        <a href="{{ path('app_location_index') }}" class="btn btn-primary mb-3">Go to Locations</a>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Date</th>
                    <th>Celsius</th>
                    <th>Prec. %</th>
                    <th>Cloudiness %</th>
                    <th>Pressure (hPa)</th>
                    <th>Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for measurement in measurements %}
                    <tr>
                        <td>{{ measurement.id }}</td>
                        <td>{{ measurement.date ? measurement.date|date('Y-m-d') : '' }}</td>
                        <td>{{ measurement.celsius }}</td>
                        <td>{{ measurement.precipitationChance }}</td>
                        <td>{{ measurement.cloudiness }}</td>
                        <td>{{ measurement.pressure }}</td>
                        <td>
                            <a class="btn btn-sm btn-secondary" href="{{ path('app_measurement_edit', {'id': measurement.id}) }}">Edit</a>

                            <form method="post" action="{{ path('app_measurement_delete', {'id': measurement.id}) }}" style="display:inline-block;" onsubmit="return confirm('Are you sure?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ measurement.id) }}">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center">No measurements found</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
